{
  "manifest_version": 3,
  "name": "Edu Filter",
  "version": "1.12.0",
  "description": "Remember the lectures you watch: quiz breaks for long YouTube lectures, with a summary and an interactive quiz in Gemini.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content_yt.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Edu Filter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  }
}
