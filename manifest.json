{
  "manifest_version": 3,
  "name": "Edu Filter",
  "version": "1.4.0",
  "description": "Tracks YouTube watch time and uses Gemini to turn useful videos into summaries and quizzes.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content_yt.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Edu Filter",
    "default_popup": "popup.html"
  }
}
